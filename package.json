{
  "name": "ossradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "collect": "tsx scripts/collect.ts",
    "enrich": "tsx scripts/enrich.ts",
    "blurbs": "tsx scripts/blurbs.ts",
    "prebuild": "tsx scripts/retired.ts && node scripts/data-pkg.mjs && tsx scripts/routes.ts",
    "retired": "tsx scripts/retired.ts",
    "cf:build": "opennextjs-cloudflare build && node scripts/cf-postbuild.mjs",
